<Window x:Class="BikeDrive.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВелосипедДрайв — Список товаров"
        Width="1000" Height="680" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: логотип, заголовок, ФИО пользователя в правом верхнем углу, выход -->
        <Border Background="{StaticResource AdditionalBackgroundBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Resources/logo.png" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Список товаров" Foreground="White" FontSize="22"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserNameTextBlock" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="UserRoleTextBlock" Foreground="White" HorizontalAlignment="Right"
                               FontSize="12"/>
                    <Button x:Name="LogoutButton" Content="Выйти" Style="{StaticResource AccentButton}" Padding="12,4"
                            Margin="0,6,0,0" HorizontalAlignment="Right" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Поиск, сортировка, фильтрация: только менеджер и администратор -->
        <Border x:Name="ToolsPanel" Grid.Row="1" Padding="16,10" BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                BorderThickness="0,0,0,1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" TextChanged="Tools_Changed" Margin="0,0,12,0"
                         ToolTip="Поиск по названию, описанию, категории, производителю и поставщику"/>
                <ComboBox x:Name="SortComboBox" Grid.Column="1" Width="230" Margin="0,0,12,0"
                          SelectionChanged="Tools_Changed"/>
                <ComboBox x:Name="DiscountComboBox" Grid.Column="2" Width="180"
                          SelectionChanged="Tools_Changed"/>
            </Grid>
        </Border>

        <!-- Заказы: менеджер и администратор; добавление товара: только администратор -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,0">
            <TextBlock x:Name="EditHintTextBlock" Text="Чтобы изменить товар, нажмите на него в списке"
                       Foreground="Gray" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
            <Button x:Name="OrdersButton" Content="Заказы" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0" Visibility="Collapsed" Click="OrdersButton_Click"/>
            <Button x:Name="AddProductButton" Content="Добавить товар" Style="{StaticResource AccentButton}"
                    Visibility="Collapsed" Click="AddProductButton_Click"/>
        </StackPanel>

        <ListBox x:Name="ProductsListBox" Grid.Row="3" Margin="16" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <EventSetter Event="MouseLeftButtonUp" Handler="ProductItem_Click"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding RowBackground}" BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Photo}" Width="120" Height="90" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="15"
                                           TextWrapping="Wrap" Foreground="{Binding RowForeground}"/>
                                <TextBlock Text="{Binding CategoryName, StringFormat=Категория: {0}}"
                                           Foreground="{Binding RowForeground}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"
                                           TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding RowForeground}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding ManufacturerName, StringFormat=Производитель: {0}}"
                                           Foreground="{Binding RowForeground}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SupplierName, StringFormat=Поставщик: {0}}"
                                           Foreground="{Binding RowForeground}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="170">
                                <!-- Белая плашка: цвета цен по руководству читаются на любом фоне строки -->
                                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PriceText}" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding FinalPriceText}" FontSize="16" FontWeight="Bold"
                                                   Foreground="Black" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding UnitName, StringFormat=₽ / {0}}" FontSize="12" Foreground="Black"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding Stock, StringFormat=На складе: {0}}"
                                           Foreground="{Binding RowForeground}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Скидка" HorizontalAlignment="Center"
                                           Foreground="{Binding RowForeground}"/>
                                <TextBlock Text="{Binding DiscountText}" FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="{Binding RowForeground}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
