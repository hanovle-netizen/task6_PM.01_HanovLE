<Window x:Class="BikeDrive.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВелосипедДрайв — Заказ"
        Width="620" Height="600" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AdditionalBackgroundBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Resources/logo.png" Height="48"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="HeaderTextBlock" Grid.Column="1" Foreground="White" FontSize="22"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <StackPanel x:Name="IdPanel">
                    <TextBlock Text="Номер заказа"/>
                    <TextBox x:Name="IdTextBox" IsReadOnly="True" Background="#EEEEEE" Margin="0,4,0,10"/>
                </StackPanel>

                <TextBlock Text="Артикул *"/>
                <TextBox x:Name="ArticlesTextBox" Margin="0,4,0,2"
                         ToolTip="Пары «артикул товара, количество» через запятую"/>
                <TextBlock Text="Формат: артикул, количество, артикул, количество. Например: А112Т4, 2, G843H5, 1"
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Статус заказа *"/>
                <ComboBox x:Name="StatusComboBox" DisplayMemberPath="StatusName" Margin="0,4,0,10"/>

                <TextBlock Text="Адрес пункта выдачи *"/>
                <ComboBox x:Name="PickupPointComboBox" DisplayMemberPath="Address" Margin="0,4,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Дата заказа *"/>
                        <DatePicker x:Name="OrderDatePicker" Margin="0,4,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата выдачи *"/>
                        <DatePicker x:Name="DeliveryDatePicker" Margin="0,4,0,10"
                                    ToolTip="Не раньше даты заказа"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="* — обязательные поля" FontSize="12" Foreground="Gray"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="16,10" BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Click="BackButton_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeleteButton" Content="Удалить заказ" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0" Click="DeleteButton_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
