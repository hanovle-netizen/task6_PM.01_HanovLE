<Window x:Class="BikeDrive.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВелосипедДрайв — Заказы"
        Width="1000" Height="680" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AdditionalBackgroundBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Resources/logo.png" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Заказы" Foreground="White" FontSize="22"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserNameTextBlock" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="UserRoleTextBlock" Foreground="White" HorizontalAlignment="Right"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,10,16,0">
            <Button Content="Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Click="BackButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="EditHintTextBlock" Text="Чтобы изменить заказ, нажмите на него в списке"
                           Foreground="Gray" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
                <Button x:Name="AddOrderButton" Content="Добавить заказ" Style="{StaticResource AccentButton}"
                        Visibility="Collapsed" Click="AddOrderButton_Click"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="OrdersListBox" Grid.Row="2" Margin="16" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <EventSetter Event="MouseLeftButtonUp" Handler="OrderItem_Click"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource AdditionalBackgroundBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,8">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="15" TextWrapping="Wrap">
                                    <Run Text="Артикул заказа:"/>
                                    <Run Text="{Binding Articles, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusName, StringFormat=Статус заказа: {0}}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Address, StringFormat=Адрес пункта выдачи: {0}}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding OrderDateText, StringFormat=Дата заказа: {0}}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Дата доставки" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DeliveryDateText}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding OrderId, StringFormat=Заказ № {0}}" FontSize="12"
                                           Foreground="Gray" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
