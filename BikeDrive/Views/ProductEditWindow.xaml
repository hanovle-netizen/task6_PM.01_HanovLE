<Window x:Class="BikeDrive.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВелосипедДрайв — Товар"
        Width="820" Height="720" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AdditionalBackgroundBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Resources/logo.png" Height="48"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="HeaderTextBlock" Grid.Column="1" Foreground="White" FontSize="22"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Фото товара: при отсутствии показывается заглушка picture.png -->
                <StackPanel Margin="0,0,16,0">
                    <Border BorderBrush="{StaticResource AdditionalBackgroundBrush}" BorderThickness="1"
                            Width="302" Height="202">
                        <Image x:Name="PhotoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Button Content="Выбрать фото..." Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                            Click="ChoosePhotoButton_Click"/>
                    <TextBlock Text="Фото будет уменьшено до 300×200 пикселей" FontSize="12"
                               Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel x:Name="IdPanel">
                        <TextBlock Text="ID товара"/>
                        <TextBox x:Name="IdTextBox" IsReadOnly="True" Background="#EEEEEE" Margin="0,4,0,10"/>
                    </StackPanel>

                    <TextBlock Text="Артикул *"/>
                    <TextBox x:Name="ArticleTextBox" MaxLength="20" Margin="0,4,0,10"
                             ToolTip="Уникальный артикул, до 20 символов. После создания товара не меняется"/>

                    <TextBlock Text="Наименование товара *"/>
                    <TextBox x:Name="NameTextBox" MaxLength="250" Margin="0,4,0,10"/>

                    <TextBlock Text="Категория товара *"/>
                    <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="CategoryName" Margin="0,4,0,10"/>

                    <TextBlock Text="Описание товара"/>
                    <TextBox x:Name="DescriptionTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/>

                    <TextBlock Text="Производитель *"/>
                    <ComboBox x:Name="ManufacturerComboBox" DisplayMemberPath="ManufacturerName" Margin="0,4,0,10"/>

                    <TextBlock Text="Поставщик *"/>
                    <ComboBox x:Name="SupplierComboBox" DisplayMemberPath="SupplierName" Margin="0,4,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Цена, ₽ *"/>
                            <TextBox x:Name="PriceTextBox" Margin="0,4,0,10"
                                     ToolTip="Число не меньше 0, можно с копейками: 1500,50"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Единица измерения *"/>
                            <ComboBox x:Name="UnitComboBox" DisplayMemberPath="UnitName" Margin="0,4,0,10"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Количество на складе *"/>
                            <TextBox x:Name="StockTextBox" Margin="0,4,0,10"
                                     ToolTip="Целое число не меньше 0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Действующая скидка, % *"/>
                            <TextBox x:Name="DiscountTextBox" Margin="0,4,0,10"
                                     ToolTip="Целое число от 0 до 100"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="* — обязательные поля" FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="16,10" BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Click="BackButton_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeleteButton" Content="Удалить товар" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0" Click="DeleteButton_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
